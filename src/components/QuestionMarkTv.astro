<div class="tv-container">
  <img src="src/assets/tv-screen.svg" width="500" height="500" class="tv" />

  <div class="text-container">
    <span class="text" id="face">:)</span>
  </div>
</div>

<script>
  const faces = [":D", ":)", ":O", ":|", ":P"];
  const el = document.getElementById("face");

  function cycle() {
    // Random delay between 300ms and 3000ms
    const delay = 2000 + Math.random() * 10000;

    // Pick a random face
    el.textContent = faces[Math.floor(Math.random() * faces.length)];

    setTimeout(cycle, delay);
  }

  cycle();
</script>

