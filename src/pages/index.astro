---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import QuestionMarkTv from "../components/QuestionMarkTv.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <div
        style="display: flex; flex-direction: column; gap: 1px; align-items: center"
        ;
      >
        <h1>Hey there!</h1>
        <QuestionMarkTv />
        <p>
          Welcome to my little part of the internet. This is a place for my
          (mostly) tech ramblings. It's currently pretty new so my ramblings are
          limited, but watch this space.
        </p>
      </div>
    </main>

    <Footer />
  </body>
</html>
